<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HealthCheckupManager" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_variant</item>
        <item name="colorOnSecondary">@color/on_background</item>
        <item name="android:colorBackground">@color/background</item>
        <!-- targetSdk 35 では edge-to-edge が強制されるため statusBarColor は無効。
             ステータスバー背景は MainActivity の window insets 処理でツールバーが
             covering する。アイコン色のみここで制御する。 -->
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
