rules_version = '2';

// 健康診断確認ツール（health-checkup-manager）Firestore セキュリティルール
//
// データ構造（FirestoreRepository.kt と対応）:
//   users/{uid}/records/{recordId}      診断記録
//   users/{uid}/itemMasters/{itemName}  項目マスター
//
// 方針:
//   - 健康情報という機微データを扱うため、認証済みユーザー本人以外は一切アクセス不可とする。
//   - Firestore のルールは「マッチしたルールのいずれかが allow なら許可」という OR 評価。
//     明示的に allow していないパスは既定で拒否されるため、catch-all の deny は書かない。

service cloud.firestore {
  match /databases/{database}/documents {

    // 本人のドキュメントツリー配下のみ読み書きを許可する。
    // {document=**} により records / itemMasters を含む全サブコレクションに再帰適用される。
    match /users/{uid}/{document=**} {
      // CI検証用に一時的にuidチェックを外している(検証後に元へ戻す・マージ禁止)
      allow read, write: if request.auth != null;
    }
  }
}
